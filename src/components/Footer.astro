  <div class="footer-bottom">
    <p class="footer-copyright">© Hello Art Therapy {new Date().getFullYear()}</p>
    <nav class="footer-socials" aria-label="Social links"><a href="https://www.instagram.com/helloarttherapy/">Instagram</a><a href="https://www.linkedin.com/in/anna-worthington-354648188">Linkedin</a><a href="https://open.spotify.com/show/2HYK9V80ALHtTqfCFbb2lt">Spotify</a><a href="https://www.youtube.com/channel/UCO7ijN4udMnVMYP2G2Cgp-A">YouTube</a></nav>
