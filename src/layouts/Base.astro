---
import '@fontsource/belleza/latin-400.css';
import '@fontsource/tenor-sans/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import BookAnnouncement from '../components/BookAnnouncement.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { pageDescription, structuredData, pageBreadcrumbs } from '../lib/seo.mjs';
import { imageSize } from '../lib/image-size.mjs';
interface Props { title?: string; description?: string; image?: string; article?: boolean; date?: string; keywords?: string[]; noindex?: boolean; }
const { title, description = pageDescription(site, Astro.url.pathname), image = site.poster, article = false, date, keywords, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — Hello Art Therapy` : 'Hello Art Therapy — Anna Worthington';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const socialSize = await imageSize(image);
const breadcrumbs = noindex ? [] : pageBreadcrumbs(Astro.url.pathname, title);
const schema = structuredData({ siteUrl: Astro.site, canonical, title: title || 'Hello Art Therapy', description, image: article && Astro.props.image ? socialImage : undefined, article, date, keywords, pathname: Astro.url.pathname, breadcrumbs });
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#97e7f7" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={socialSize.width} />
    <meta property="og:image:height" content={socialSize.height} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content="Hello Art Therapy" />
    <meta name="twitter:card" content="summary_large_image" />
    {date && <meta property="article:published_time" content={date} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <BookAnnouncement />
    {breadcrumbs.length > 0 && <nav class="breadcrumbs content-width" aria-label="Breadcrumb">
      <ol>{breadcrumbs.map((crumb, index) => <li>{index === breadcrumbs.length - 1 ? <span aria-current="page">{crumb.name}</span> : <a href={crumb.url}>{crumb.name}</a>}</li>)}</ol>
    </nav>}
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
