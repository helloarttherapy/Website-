---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base>
  <section class="hero" id="intro" aria-labelledby="hero-title">
    <h1 class="visually-hidden" id="hero-title">Anna Worthington Art Therapy</h1>
    <picture><source srcset={site.poster} media="(prefers-reduced-motion: reduce)" /><img src={site.hero} alt="Anna Worthington Art Therapy" width="1040" height="697" fetchpriority="high" /></picture>
    <a class="hero-scroll" href="#what-is-art-therapy" aria-label="Scroll to What is art therapy?"><span aria-hidden="true">↓</span></a>
  </section>
  <section class="intro-section section" id="what-is-art-therapy"><div class="prose intro-copy" set:html={site.definition} /></section>
  <section class="support-section section" id="what-can-it-help-with"><div class="prose support-copy" set:html={site.support} /></section>
  <section class="offer-section section" id="what-i-offer"><div class="prose" set:html={site.offer} /></section>
  <section class="testimonials-section section" id="testimonials"><div class="prose testimonials" set:html={site.testimonials} /></section>
  <section class="social-section section" id="social"><h2>Art therapy on social</h2><div class="social-grid">{site.social.map((item,index)=><a href={item.url} aria-label={`View artwork ${index+1} on Instagram`}><img src={item.image} alt={item.alt} loading="lazy" decoding="async" width="640" height="640" /></a>)}</div><a class="button" href="/contact">Get in touch</a></section>
</Base>
