---
const links = [{href:'/new-page',label:'What is art therapy?'},{href:'/how-it-works',label:'How it works'},{href:'/about-1',label:'About Anna'},{href:'/blog',label:'Blog'},{href:'/contact',label:'Say hello'}];
const path=Astro.url.pathname;
---
<header class="site-header">
  <a href="/" class="wordmark" aria-label="Hello Art Therapy home"><span class="flower" aria-hidden="true">✳</span><span>Hello<br />Art Therapy</span></a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {links.map(link=><a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined} class:list={[{'nav-cta':link.href==='/contact'}]}>{link.label}{link.href==='/contact' && <span aria-hidden="true">↗</span>}</a>)}
  </nav>
  <details class="mobile-menu">
    <summary aria-label="Navigation menu"><span>Menu</span><span aria-hidden="true">☰</span></summary>
    <nav aria-label="Mobile navigation">{links.map(link=><a href={link.href} aria-current={path.startsWith(link.href)?'page':undefined}>{link.label}<span aria-hidden="true">↗</span></a>)}</nav>
  </details>
</header>
