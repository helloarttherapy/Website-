---
interface Props { post: {title:string;url:string;date:string;displayDate:string;excerpt:string;image?:string}; }
const {post}=Astro.props;
---
<article class="post-card">
  {post.image && <a href={post.url} class="post-image" tabindex="-1" aria-hidden="true"><img src={post.image} alt="" loading="lazy" decoding="async" /></a>}
  <h2><a href={post.url}>{post.title}</a></h2>
  {post.excerpt && <div class="post-excerpt" set:html={post.excerpt} />}
  <p class="post-meta"><time datetime={post.date}>{post.displayDate}</time></p>
</article>
