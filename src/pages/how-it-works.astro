---
import Base from '../layouts/Base.astro';
import Invitation from '../components/Invitation.astro';
import site from '../data/site.json';
---
<Base title="How it works" description="Explore individual, parent and child, and group art therapy sessions with Anna Worthington. In person in Fitzroy, Victoria, or online.">
  <header class="page-heading blue"><p class="eyebrow">No art experience needed</p><h1>Say hello to the<br /><em>creative process.</em></h1><span class="flower" aria-hidden="true">✳</span></header>
  <section class="prose article-body sessions" id="sessions" set:html={site.how} />
  <Invitation />
</Base>
