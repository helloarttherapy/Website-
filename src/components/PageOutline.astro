---
interface Props { title: string; links: { href: string; label: string }[]; }
const { title, links } = Astro.props;
---
<aside class="page-outline">
  <nav class="outline-desktop" aria-label={title}>
    {links.map(link => <a href={link.href}>{link.label}</a>)}
  </nav>
  <details class="outline-mobile"><summary>{title}</summary>
    <nav aria-label={title}>{links.map(link => <a href={link.href}>{link.label}</a>)}</nav>
  </details>
</aside>
<script>
  const outline = document.querySelector<HTMLDetailsElement>('.outline-mobile');
  outline?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => { outline.open = false; });
  });
  outline?.addEventListener('keydown', event => {
    if (event.key === 'Escape' && outline.open) {
      outline.open = false;
      outline.querySelector('summary')?.focus();
    }
  });
</script>
