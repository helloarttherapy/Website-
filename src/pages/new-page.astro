---
import Base from '../layouts/Base.astro';
import Invitation from '../components/Invitation.astro';
import site from '../data/site.json';
import { therapyLayout } from '../lib/content-layout.mjs';
const therapy = therapyLayout(site.therapy.replace(/^\s*<h2>What is Art Therapy\?<\/h2>/,''));
---
<Base title="What is Art Therapy?">
  <header class="page-heading"><h1>What is Art Therapy?</h1></header>
  <article class="prose article-body therapy-body content-width">
    <div class="therapy-lead"><div set:html={therapy.figure} /><div set:html={therapy.introduction} /></div>
    <div class="therapy-opening" set:html={therapy.opening} />
    {therapy.sections.map((section, index) => <section class="therapy-chapter" aria-labelledby={`therapy-section-${index}`}>
      <h2 class="therapy-section-title" id={`therapy-section-${index}`}>{section.title === 'So with all this in mind… What do we get up to in art therapy?' ? <a class="section-link" href="/how-it-works#sessions">{section.title}</a> : section.title}</h2>
      <div set:html={section.body} />
    </section>)}
  </article>
  <Invitation />
</Base>
