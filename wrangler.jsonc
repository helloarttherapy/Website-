{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hello-art-therapy",
  "main": "worker/index.mjs",
  "account_id": "f42f869e89836bba54e556cb172b1226",
  "compatibility_date": "2026-10-10",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/contact"],
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "ratelimits": [{"name": "CONTACT_RATE_LIMITER", "namespace_id": "1001", "simple": {"limit": 5, "period": 60}}],
  "send_email": [{"name": "EMAIL", "destination_address": "anna@helloarttherapy.com", "allowed_sender_addresses": ["website@annaworthingtonarttherapy.com"]}]
}
