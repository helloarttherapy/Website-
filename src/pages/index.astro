---
import Base from '../layouts/Base.astro';
import Invitation from '../components/Invitation.astro';
import PostCard from '../components/PostCard.astro';
import site from '../data/site.json';
---
<Base>
  <section class="hero" id="intro" aria-labelledby="hero-title">
    <h1 class="visually-hidden" id="hero-title">Anna Worthington Art Therapy</h1>
    <picture><source srcset={site.poster} media="(prefers-reduced-motion: reduce)" /><img src={site.hero} alt="Anna Worthington Art Therapy — an animated, handwritten welcome" width="1040" height="697" fetchpriority="high" /></picture>
    <div class="hero-bottom"><p>Creative expression. Personal connection.</p><a href="#what-is-art-therapy" aria-label="Discover art therapy">Explore <span aria-hidden="true">↓</span></a></div>
  </section>
  <section class="intro-section section" id="what-is-art-therapy">
    <div><p class="eyebrow">A different way to explore</p><h2>Sometimes, there’s<br /><em>more than words.</em></h2><a class="text-link" href="/new-page">What is art therapy? <span aria-hidden="true">↗</span></a></div>
    <div class="prose intro-copy" set:html={site.definition.replace(/<h2>.*?<\/h2>/,'')} />
  </section>
  <section class="support-section section" id="what-can-it-help-with"><p class="eyebrow">Space for your experience</p><div class="prose support-copy" set:html={site.support} /></section>
  <section class="offer-section section" id="what-i-offer"><div class="portrait-frame"><img src={site.portrait} alt="Anna Worthington" loading="lazy" decoding="async" /></div><div><p class="eyebrow">Meet Anna</p><div class="prose" set:html={site.offer.replace(/<a[^>]*>[^<]*<\/a>/g,'')} /><p>In the studio in Fitzroy, or online, wherever you are.</p><div class="button-row"><a class="button" href="/how-it-works">Explore the sessions <span aria-hidden="true">↗</span></a><a class="text-link" href="/about-1">About Anna ↗</a></div></div></section>
  <section class="testimonials-section section" id="testimonials"><p class="eyebrow">In their own words</p><div class="prose testimonials" set:html={site.testimonials} /></section>
  <section class="journal-section section"><div class="section-heading"><div><p class="eyebrow">From Anna’s journal</p><h2>Words, pictures<br /><em>and things.</em></h2></div><a class="text-link" href="/blog">All stories ↗</a></div><div class="post-grid">{site.posts.slice(0,3).map(post=><PostCard post={post} />)}</div></section>
  <section class="social-section section" id="social"><div class="section-heading"><div><p class="eyebrow">Art, life & everything between</p><h2>Art therapy on social.</h2></div><a class="text-link" href="https://www.instagram.com/helloarttherapy/">@helloarttherapy ↗</a></div><div class="social-grid">{site.social.map((item,index)=><a href={item.url} aria-label={`View artwork ${index+1} on Instagram`}><img src={item.image} alt={item.alt} loading="lazy" decoding="async" width="640" height="640" /></a>)}</div></section>
  <Invitation />
</Base>
