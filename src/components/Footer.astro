  <div class="content-width">
  <div class="footer-top">
    <a class="footer-logo" href="/"><img src="/images/original-logo-white.png" alt="Anna Worthington Art Therapy" {...logoSize} loading="lazy" /></a>
    <nav aria-label="Footer navigation"><a href="/about-1">About</a><a href="/how-it-works">How it works</a><a href="/blog">Blog</a><a href="/art-for-the-everyday">Art for the Everyday</a><a class="footer-cta" href="/contact">Get in touch</a></nav>
