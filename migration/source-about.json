w 1500w, https://images.squarespace-cdn.com/content/v1/5c14af5bec4eb7fbe157b043/2bd754e3-4e2d-49bb-9b83-d5813201dbc3/Anna_Worthington.jpg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n            </div>\n          </div>\n        \n          \n        \n\n        \n      \n        </figure>\n      \n\n    </div>\n  \n\n\n  \n\n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-border-radii=\"&#123;&quot;topLeft&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;topRight&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;bottomLeft&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;bottomRight&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;&#125;\" data-sqsp-block=\"text\" id=\"block-yui_3_17_2_1_1704783821275_72754\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">Say hello to art therapy with Anna.</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div></div><div class=\"col sqs-col-6 span-6\"><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-border-radii=\"&#123;&quot;topLeft&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;topRight&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;bottomLeft&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;bottomRight&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;&#125;\" data-sqsp-block=\"text\" id=\"block-6f9b50a8fa9ea9ab9779\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">Born in the outskirts of Melbourne, Australia I spent 15 years abroad where I worked in various creative industries as I found my feet in life. This would be the starting point for my ongoing curiosity around creativity, identity, self-expression and the healing power of the arts. My developing awareness led me to return to Melbourne to complete a Masters in Expressive Arts Therapies. These qualifications extended my learning so I could more deeply support others' creative expression, leading to greatly improved wellbeing. Professionally, I have worked in a variety of contexts which have afforded me a rich diversity of clients with relational, psychological, emotional and developmental needs.&nbsp;</p><p class=\"\" style=\"white-space:pre-wrap;\">The ongoing practice of art-making, thinking creatively and philosophically is central to my life which continues to inform and inspire me in my work, while the experience of being with others animates and gives life to my writing habit.&nbsp;</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\" data-aspect-ratio=\"3.7735849056603774\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/2e75b06b-a4fd-4b48-817e-b5a62b4cb1cc_1296/website.components.spacer.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/2e75b06b-a4fd-4b48-817e-b5a62b4cb1cc_1296/website.components.spacer.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.spacer\" data-website-component-id=\"3e2be7e108362b17b137\" id=\"block-3e2be7e108362b17b137\"><div class=\"sqs-block-content\">&nbsp;</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-border-radii=\"&#123;&quot;topLeft&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;topRight&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;bottomLeft&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;,&quot;bottomRight&quot;:&#123;&quot;unit&quot;:&quot;px&quot;,&quot;value&quot;:0.0&#125;&#125;\" data-sqsp-block=\"text\" id=\"block-c4856c444ef647a6a9f3\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <h3 style=\"white-space:pre-wrap;\">Experience</h3><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Ikon Institute of Australia, Lecturer</strong><br>Teaching a range of subjects covering the philosophical foundations of art psychotherapy as well as many other aspects of practice.<br><em>Feb 2021 - Current</em><br><br><strong>headspace Australia, Group Facilitator</strong><br>Running groups focusing on creative and interpersonal skill development.<br><em>Feb 2019 - June 2020</em><br><br><strong>headspace Australia, Intern</strong><br>Over 175hrs completed including groups, individual sessions and caregiver/young person work.<br><em>Feb 2018 - Nov 2018</em><br><br><strong>MerriHealth, Intern</strong><br>Over 100hrs completed including focused groups, open art studio and individual sessions.<br><em>Feb 2017 - July 2017</em></p><p class=\"\" style=\"white-space:pre-wrap;\"><strong>Private Practice<br></strong>Private individual sessions, via Anna Worthington Art Therapy.<br><em>Jan 2016 - ongoing</em></p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-spacer spacer-block sized vsize-1\" data-aspect-ratio=\"3.7735849056603774\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/2e75b06b-a4fd-4b48-817e-b5a62b4cb1cc_1296/website.components.spacer.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.spacer/2e75b06b-a4fd-4