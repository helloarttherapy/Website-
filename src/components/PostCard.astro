---
interface Props { post: {title:string;url:string;date:string;displayDate:string;excerpt:string;image?:string}; featured?: boolean; }
import { imageSize } from '../lib/image-size.mjs';
const {post, featured = false}=Astro.props;
const dimensions = await imageSize(post.image);
---
<article class:list={['post-card', {'post-featured': featured}]}>
  {post.image && <div class="post-image"><img src={post.image} alt="" {...dimensions} loading={featured ? 'eager' : 'lazy'} fetchpriority={featured ? 'high' : undefined} decoding="async" /></div>}
  <div class="post-details">
  <h2><a href={post.url}>{post.title}</a></h2>
  {post.excerpt && <div class="post-excerpt" set:html={post.excerpt} />}
  <p class="post-meta"><time datetime={post.date}>{post.displayDate}</time></p>
  </div>
</article>
